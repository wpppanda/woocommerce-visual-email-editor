msgstr "<p style=\"margin:0;\">Свой HTML</p>"

msgid "<p>Hi {customer_first_name},</p><p>An account has been created for you at {site_title}. Set a password and you can see your orders any time.</p>"
msgstr "<p>Здравствуйте, {customer_first_name}.</p><p>Для вас создан аккаунт в {site_title}. Задайте пароль — и заказы будут под рукой.</p>"

msgid "<p>Hi {customer_first_name},</p><p>Here is an update from {site_title}. The details we have are below.</p>"
msgstr "<p>Здравствуйте, {customer_first_name}.</p><p>Новость от {site_title}. Подробности, которые у нас есть, ниже.</p>"

msgid "<p>Hi {customer_first_name},</p><p>Order #{order_number} is complete. We hope it is exactly what you wanted — and if it is not, reply to this email.</p>"
msgstr "<p>Здравствуйте, {customer_first_name}.</p><p>Заказ #{order_number} выполнен. Надеемся, всё как вы хотели. Если нет — ответьте на это письмо.</p>"

msgid "<p>Hi {customer_first_name},</p><p>Someone asked to reset the password for {user_login}. If that was you, use the button. If it was not, you can ignore this email.</p>"
msgstr "<p>Здравствуйте, {customer_first_name}.</p><p>Кто-то запросил сброс пароля для {user_login}. Если это вы — нажмите кнопку. Если нет — просто проигнорируйте письмо.</p>"

msgid "<p>Hi {customer_first_name},</p><p>Thank you. We have received order #{order_number} and we are getting it ready. This email is the receipt — the next one arrives when it ships.</p>"
msgstr "<p>Здравствуйте, {customer_first_name}.</p><p>Спасибо. Заказ #{order_number} получен, мы его собираем. Это письмо — чек. Следующее придёт, когда заказ отправится.</p>"

msgid "<p>Hi {customer_first_name},</p><p>Write the note you actually want them to read.</p>"
msgstr "<p>Здравствуйте, {customer_first_name}.</p><p>Напишите здесь то, что человек действительно прочитает.</p>"

msgid "<p>You have a new order from {customer_full_name} — #{order_number}, placed on {order_date}.</p>"
msgstr "<p>Новый заказ от {customer_full_name} — #{order_number}, от {order_date}.</p>"

